  <MdxScripts>
    <MdxScript dwd:design-time-name="c469f556-7ad3-4d85-9749-ec533a2f7b8c">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;     
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Temperature]
 AS [Measures].[Temperature Celsius] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Feels Like]
 AS [Measures].[Feels Like Celsius] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Temp Difference]
 AS [Measures].[Avg Feels Like] - [Measures].[Avg Temperature], 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Precip Mm]
 AS [Measures].[Precip Mm] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Humidity]
 AS [Measures].[Humidity] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Cloud]
 AS [Measures].[Cloud] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Wind Kph]
 AS [Measures].[Wind Kph] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Wind Degree]
 AS [Measures].[Wind Degree] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Pressure Mb]
 AS [Measures].[Pressure Mb] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Visibility Km]
 AS [Measures].[Visibility Km] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Uv Index]
 AS [Measures].[Uv Index] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Air Quality Ozone]
 AS [Measures].[Air Quality Ozone] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Air Quality Pm25]
 AS [Measures].[Air Quality Pm25] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Air Quality Pm10]
 AS [Measures].[Air Quality Pm10] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1;    
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Moon Illumination]
 AS [Measures].[Moon Illumination] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Gust Kph]
 AS [Measures].[Gust Kph] / [Measures].[FACT WEATHER Count], 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
